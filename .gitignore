# No virtual environments in this project - dependencies are installed into
# global Python from requirements.txt. These lines stop one creeping back in.
.venv/
venv/
env/

# Python bytecode
__pycache__/
*.py[cod]

# Notebook checkpoints
.ipynb_checkpoints/

# Scraper progress files - resumable state, not results. Regenerated by
# scrape_movies.py and meaningless on anyone else's machine.
scrape_candidates.json
scrape_progress_reviews.jsonl
scrape_progress_cast.jsonl

# NOT ignored, on purpose:
#   model.pkl          the deployed app must run the exact model that was tested
#   actor_snapshot.csv the app reads it at startup; regenerating needs the pipeline
#   *.csv              the whole dataset is the point of the repo
